# =============================================================
# ARCHEION LEGAL OPS — Variables de entorno
# =============================================================
# Copiar este archivo a .env.local (desarrollo) o configurar
# en Vercel Dashboard → Settings → Environment Variables
#
# ⚠️  NUNCA subir .env.local al repositorio
# ⚠️  Las variables VITE_ son PÚBLICAS (visibles en el navegador)
# ⚠️  Las demás variables son PRIVADAS (solo servidor)
# =============================================================

# --- BASE DE DATOS (PRIVADA — solo servidor) ---
# URL de conexión a PostgreSQL (Neon, Supabase Postgres, etc.)
# Formato: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://user:password@host:port/database

# --- SESIONES (PRIVADA — solo servidor) ---
# Secreto para firmar tokens JWT (mínimo 32 caracteres)
# Generar con: openssl rand -base64 32
SESSION_SECRET=change-this-to-a-random-secret-min-32-characters

# --- USUARIO INICIAL (PRIVADA — solo primer despliegue) ---
# Email y contraseña del propietario (solo para crear el primer usuario)
# Después del primer despliegue, eliminar estas variables
INITIAL_USER_EMAIL=admin@example.com
INITIAL_USER_PASSWORD=change-this-password

# --- FRONTEND (PÚBLICAS — empiezan por VITE_) ---
# URL de la API (en producción es la misma URL del sitio)
VITE_API_URL=
