# Plantilla de variables de entorno para ARCHEION LEGAL OPS
# Copiar a .env.local y rellenar con los valores reales.
#
# ⚠️  NUNCA subir .env.local al repositorio.
# ⚠️  NUNCA usar la service_role key en el navegador.
# ⚠️  Las claves anon son PÚBLICAS y seguras para el cliente.
#
# Valores reales en:
#   Vercel  → Project Settings → Environment Variables
#   Supabase → Settings → API

# URL completa del proyecto Supabase (NO el nombre del proyecto).
# Formato correcto: https://<project-ref>.supabase.co
# Formato INCORRECTO que causó el bug original: "manuel-gago-web"
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Clave pública anon de Supabase (empieza por eyJ...).
# Obtener en: Supabase Dashboard → Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# URL pública del sitio (se usa para construir emailRedirectTo del magic link).
# Producción:
NEXT_PUBLIC_SITE_URL=https://archeion-legal-ops.vercel.app
# Desarrollo local:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
